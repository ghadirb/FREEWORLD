	"err_brush_blocks_only": "قلم‌مو فقط روی بلوک‌هایی که خودتان ساخته‌اید رنگ می‌کند، نه ساختمان‌های آماده.",
	"book_lg_medieval_fort_1": "ردپای نگهبان",
	"book_lg_medieval_fort_1_d": "سیمین می‌گوید آخرین نگهبان قلعه نشانه‌ای برای ما گذاشته. به ستون سنگیِ نشانه‌دار نزدیک قلعه برو و کنارش بایست.",
	"book_lg_medieval_fort_1_s": "زیر ستون، تکه‌ای پارچهٔ سرخ با نشان قلعه گیر کرده است. نگهبان عجله داشته و از راه اصلی نرفته؛ ردپایش به‌سوی بیرون قلعه می‌رود.",
	"book_lg_medieval_fort_2": "چاه فراموش‌شده",
	"book_lg_medieval_fort_2_d": "پوریا از چاهی قدیمی در بیرون قلعه می‌گوید که نگهبان آنجا آب می‌برد. ستون سنگی بعدی کنار آن است.",
	"book_lg_medieval_fort_2_s": "کنار چاه، طنابی تازه گره خورده است. تا همین چند روز پیش کسی از آن استفاده می‌کرده و ته چاه چیزی می‌درخشد که هنوز به آن نمی‌رسی.",
	"book_lg_medieval_fort_3": "غار ناقوس",
	"book_lg_medieval_fort_3_d": "آرش می‌گوید صدای ناقوسی از غاری سنگی در شرق قلعه می‌آید. از درگاهش وارد شو و کنار ستون میانیِ غار بایست.",
	"book_lg_medieval_fort_3_s": "داخل غار خنک و تاریک است و صدای ناقوس از همین‌جا می‌آید. نگهبان ناقوس را اینجا پنهان کرده بود تا هر وقت خطر نزدیک شد، فقط خودی‌ها بفهمند.",
	"book_lg_medieval_fort_4": "پل شکستهٔ مزرعه",
	"book_lg_medieval_fort_4_d": "بهرام می‌گوید نگهبان از مزرعه‌ها گذشته و کنار پلی شکسته چیزی گذاشته. به ستون چهارم برس.",
	"book_lg_medieval_fort_4_s": "زیر پل شکسته، در شکاف سنگ، یادداشتی نیمه‌سوخته هست: «مهر را نزد سیمین ببر و به هیچ‌کس دیگر اعتماد نکن.»",
	"book_lg_medieval_fort_5": "گنجینهٔ سیمین",
	"book_lg_medieval_fort_5_d": "آخرین ستون قصه را کامل می‌کند: مهر شاه از اینجا نگهبانی می‌شود. به آن برس و افسانهٔ قلعه را تمام کن.",
	"book_lg_medieval_fort_5_s": "تالار خاموش است و مهر شاه روی سکو می‌درخشد. حالا می‌دانی نگهبان چرا رفت: او مهر را نبرد، آن را نگه داشت تا قلعه فراموشش نکند.",
	"book_lg_frozen_north_1": "ردّ گرگ سفید",
	"book_lg_frozen_north_1_d": "بهمن از ردپاهای گرگی سفید روی برف می‌گوید. ردّ را تا ستون سنگیِ اول دنبال کن.",
	"book_lg_frozen_north_1_s": "زیر برف، لانهٔ خالی گرگی پیدا می‌کنی. شکارچی می‌گوید گرگ‌ها وقتی رفتند که سرمای بی‌موقع آمد؛ چیزی از شمال آن‌ها را راند.",
	"book_lg_frozen_north_2": "کلبهٔ متروک",
	"book_lg_frozen_north_2_d": "شیرین می‌گوید شکارچی‌ای مدت‌ها پیش در کلبه‌ای دور ماند. ستون دوم همان‌جاست.",
	"book_lg_frozen_north_2_s": "کنار آتشی که دود نمی‌کند، سفرنامه‌ای یخ‌زده افتاده است. صاحب مسافرخانه می‌گوید مسافرش از آن‌سوی دریاچه نوری دیده بود.",
	"book_lg_frozen_north_3": "چشمهٔ یخ‌نزده",
	"book_lg_frozen_north_3_d": "بهمن می‌گوید چشمه‌ای هست که زمستان هم نمی‌بندد. ستون سوم کنار آن است.",
	"book_lg_frozen_north_3_s": "روی دریاچهٔ یخ‌زده ترک‌هایی هست که به یک نقطه می‌رسند. زیر یخ شکلی تیره دیده می‌شود، ولی هنوز وقت بیرون آوردنش نیست.",
	"book_lg_frozen_north_4": "قلهٔ ستاره‌ها",
	"book_lg_frozen_north_4_d": "داراب می‌گوید شب‌ها ستاره‌ها بالای یک قله خیلی نزدیک می‌شوند. به ستون آخر برس.",
	"book_lg_frozen_north_4_s": "سنگ‌های بلند دایره‌وار ایستاده‌اند و وسطشان گرم است. پیرمرد می‌گوید این‌جا قلب زمستان است؛ تا وقتی کسی بیدارش نکند، شمال زنده می‌ماند.",
	"book_lg_desert_caravan_1": "چاه نخستین کاروان",
	"book_lg_desert_caravan_1_d": "کاوه می‌گوید کاروان اول کنار چاهی بی‌نام آب برداشت. ستون سنگی اول آنجاست.",
	"book_lg_desert_caravan_1_s": "ردی از کاروانی گم‌شده در شن مانده است؛ شترها هنوز از همین مسیر می‌گذشتند که طوفان آمد. نشانه‌ها می‌گویند همه زنده بودند.",
	"book_lg_desert_caravan_2": "ستون سرخ",
	"book_lg_desert_caravan_2_d": "گلنار از سنگی سرخ می‌گوید که مسافران با آن راه را پیدا می‌کردند. ستون دوم را پیدا کن.",
	"book_lg_desert_caravan_2_s": "کنار چاهی خشک، کوزه‌ای مهرشده پیدا می‌کنی. صاحب مسافرخانه می‌گوید آب این چاه فقط شب‌ها برمی‌گردد.",
	"book_lg_desert_caravan_3": "کتیبهٔ شن",
	"book_lg_desert_caravan_3_d": "مهرداد می‌گوید باد کتیبه‌ای قدیمی را نشان داده است. ستون سوم کنار آن است.",
	"book_lg_desert_caravan_3_s": "کوره‌ای قدیمی نیمه‌دفن در شن است. آهنگر از روی خرده‌های آهن می‌گوید این‌جا برای کاروان نعل و ابزار می‌ساخته‌اند.",
	"book_lg_desert_caravan_4": "ستارهٔ صحرا",
	"book_lg_desert_caravan_4_d": "کاوه می‌گوید آخرین نشانه جایی است که کاروان‌ها زیر ستاره‌ها جمع می‌شدند. به ستون آخر برس.",
	"book_lg_desert_caravan_4_s": "در سایهٔ سنگی بزرگ، نقشهٔ کاروان روی پوست حک شده و آخرین نشانه‌اش به واحه‌ای پنهان می‌رسد؛ کاروان گم نشد، پنهان شد.",
	"scen_space_colony": "پایگاه فضایی",
	"scen_space_colony_desc": "ماه: خاک خاکستری، ستون‌های بلور، آسمان سیاه، سکوی فرود با موشک، گنبد زیستگاه و آزمایشگاه.\nپیشنهاد: از بلورها چوب بگیر، با شیشه گنبد و باغ بساز، پنل خورشیدی بگذار و پایگاهت را بزرگ کن.",
	"book_dust_walker": "گام روی ماه",
	"book_dust_walker_d": "روی خاک خاکستری ماه قدم بزن.",
	"book_crystal_find": "بلورزار",
	"book_crystal_find_d": "به یک بلورزار برس.",
	"book_crater_rim": "لبهٔ دهانه",
	"book_crater_rim_d": "از صخره‌های بلند ماه بالا برو (۱۸ متر).",
	"book_dome_builder": "گنبدساز",
	"book_dome_builder_d": "۳۰ بلوک شیشه بگذار.",
	"book_lg_space_colony_1": "علامت فرود",
	"book_lg_space_colony_1_d": "سارا می‌گوید نخستین فرودگر علامتی کنار دهانه‌ای دور گذاشت. ستون اول آنجاست.",
	"book_lg_space_colony_1_s": "ردپاهای قدیمی فضانورد هنوز در گرد ماه مانده است؛ بادی نیست که پاکشان کند.",
	"book_lg_space_colony_2": "ایستگاه خاموش",
	"book_lg_space_colony_2_d": "نیما از ایستگاهی رهاشده می‌گوید که گیرنده‌اش هنوز یک پیام را تکرار می‌کند. ستون دوم را پیدا کن.",
	"book_lg_space_colony_2_s": "ایستگاه خاموش است، اما چراغ کوچکی روی تابلوی فرمانش می‌سوزد. نیما می‌گوید کسی پیش از رفتن آن را روشن گذاشته.",
	"book_lg_space_colony_3": "باغ بلور",
	"book_lg_space_colony_3_d": "کامران می‌گوید بلورها در تاریکی می‌درخشند. ستون سوم میان آن‌هاست.",
	"book_lg_space_colony_3_s": "ستون‌های بلور مثل جنگلی از شیشه‌اند و نور ستاره‌ها را می‌شکنند؛ کامران می‌گوید شاید این‌ها هم بذرند.",
	"book_lg_space_colony_4": "پایان پیام",
	"book_lg_space_colony_4_d": "آیدا می‌گوید پیام از جایی دورتر می‌آید. به ستون آخر برس.",
	"book_lg_space_colony_4_s": "در مرکز دشت یک سنگ‌نوشتهٔ صاف است که فقط شب دیده می‌شود: «اینجا خانه‌ای بساز.» پیام همان‌قدر ساده بود.",
	"book_legend": "🧭 مقصد بعدی افسانه: %s — حدود %s متر، %s",
	"book_lg_green_valley_1": "سنگ نخستین کشاورز",
	"book_lg_green_valley_1_d": "علی می‌گوید اولین کشاورز دره سنگی گذاشت تا زمین را نشان بدهد. به ستون سنگیِ اول برس.",
	"book_lg_green_valley_1_s": "کنار درخت پیر، خیش زنگ‌زده‌ای هست. کشاورز می‌گوید پدربزرگش اولین گندم دره را همین‌جا کاشت.",
	"book_lg_green_valley_2": "چشمهٔ نان",
	"book_lg_green_valley_2_d": "مریم از چشمه‌ای می‌گوید که خمیر نانوایی‌های قدیمی با آبش ورز می‌آمد. ستون دوم کنار آن است.",
	"book_lg_green_valley_2_s": "در آسیاب خرابه هنوز بوی آرد می‌آید. نانوا می‌گوید قدیم‌ترها همهٔ دره نانش را از همین‌جا می‌پخت.",
	"book_lg_green_valley_3": "تپهٔ بادبادک‌ها",
	"book_lg_green_valley_3_d": "رضا از تپه‌ای می‌گوید که بچه‌ها بادبادک می‌پراندند. ستون سوم آنجاست.",
	"book_lg_green_valley_3_s": "از بالای تپه، دره مثل کاسه‌ای سبز پیداست و رودی که آن را دو نیم می‌کند. راهنما می‌گوید قدیمی‌ها نقشهٔ آب را از این‌جا کشیدند.",
	"book_lg_green_valley_4": "گنج دره‌ی سبز",
	"book_lg_green_valley_4_d": "آخرین ستون جایی است که کشاورزان بهترین محصول سال را پنهان می‌کردند. به آن برس.",
	"book_lg_green_valley_4_s": "زیر آخرین درخت، سنگی با نام خانواده‌ها هست. دره از کسی نبوده؛ همه با هم ساخته‌اند، و حالا تو هم نامی بر آن می‌افزایی.",
	"book_lg_island_castaway_1": "بطری روی ساحل",
